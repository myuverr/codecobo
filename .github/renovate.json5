// SPDX-License-Identifier: MPL-2.0

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      // The shared script writes locks and verification metadata together.
      "skipArtifactsUpdate": true
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "postUpgradeTasks": {
        "executionMode": "branch",
        "commands": ["bash .github/scripts/update-gradle-artifacts.sh"],
        "fileFilters": ["**/*.lockfile", "gradle/verification-metadata.xml"]
      }
    },
    {
      "matchManagers": ["gradle"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchNewValue": "/^[0-9]+(\\.[0-9]+)+$/",
      "groupName": "Gradle libraries"
    },
    {
      "matchManagers": ["gradle"],
      "matchDepTypes": ["plugin"],
      "matchDepNames": [
        "com.android.*",
        "org.jetbrains.kotlin.*",
        "com.google.devtools.ksp"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "matchNewValue": "/^[0-9]+(\\.[0-9]+)+$/",
      "groupName": "Android build toolchain"
    }
  ]
}
