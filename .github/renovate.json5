// SPDX-License-Identifier: MPL-2.0

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "postUpgradeTasks": {
        "executionMode": "branch",
        "commands": [
          "./gradlew --no-daemon --no-configuration-cache --refresh-dependencies --write-verification-metadata sha256 testDebugUnitTest lintDebug lintRelease assembleDebug assembleRelease"
        ],
        "fileFilters": ["gradle/verification-metadata.xml"]
      }
    }
  ]
}
