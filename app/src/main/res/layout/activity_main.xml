<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipChildren="false">
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" />
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/navigation" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="12dp" />
</FrameLayout>
